# Telegram Configuration
# 1. Open Telegram and search for "BotFather"
# 2. Send /newbot command
# 3. Follow instructions to get your token
# 4. Paste the token below

TELEGRAM_BOT_TOKEN=your_token_here_from_botfather

# Your Telegram Chat ID (for cross-channel messaging)
# Message @userinfobot on Telegram to get your chat ID
TELEGRAM_OWNER_CHAT_ID=

# Discord Bot Token
# Create app/bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Slack Bot/App Tokens
# Bot token starts with xoxb-, App token starts with xapp-
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# WhatsApp channel uses QR login (no token needed)
# Session is stored under ./.wwebjs_auth after first successful scan

# Optional: LLM Keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional comma-separated credential/model pools used for automatic failover.
OPENROUTER_API_KEYS=
OPENROUTER_FALLBACK_MODELS=
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
NVIDIA_FALLBACK_MODELS=

# OpenCode Zen (OpenAI-compatible AI gateway) — used as automatic fallback
# when OpenRouter fails. Get a key at https://opencode.ai/auth
# Base URL: https://opencode.ai/zen/v1  (models fetched live from /v1/models)
OPENCODE_API_KEY=
# Default model to use for OpenCode Zen (e.g. gpt-5.5, deepseek-v4-flash-free)
OPENCODE_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Semantic Memory Embeddings (OpenAI-compatible /embeddings endpoint)
# Defaults can also be set in config.json under memory.semantic.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# A2A (Agent-to-Agent) Auth Token (optional)
A2A_AUTH_TOKEN=

# Brave Search API (get free key at https://api.search.brave.com/)
BRAVE_SEARCH_API_KEY=

# Serper API (https://serper.dev)
SERPER_API_KEY=

# GitHub Personal Access Token (https://github.com/settings/tokens)
# Generate a fine-grained or classic token with repo access
GITHUB_TOKEN=

# Speech-to-Text (STT) Provider
# Options: deepgram | whisper
STT_PROVIDER=deepgram

# Local Whisper (Python) settings
WHISPER_PYTHON=python
WHISPER_SCRIPT=scripts/whisper_transcribe.py
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=
WHISPER_TIMEOUT_MS=120000
# Optional key for OpenAI-compatible /v1 endpoints. Use a long random value.
GITU_API_KEY=
